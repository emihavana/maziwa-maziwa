# =====================================================================
# TALL stack (Tailwind, Alpine, Laravel, Livewire) + Filament
# =====================================================================

# ---------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------
/vendor
/node_modules
composer.phar
auth.json                      # Composer credentials (private packages, e.g. Filament plugins)

# ---------------------------------------------------------------------
# Environment and secrets: NEVER commit these
# ---------------------------------------------------------------------
.env
.env.backup
.env.production
.env.local
.env.*.local
# Keep the template so teammates know which variables are needed
!.env.example

# ---------------------------------------------------------------------
# Laravel runtime / generated files
# ---------------------------------------------------------------------
/storage/*.key
/storage/pail
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/debugbar
/bootstrap/cache/*.php
/public/hot
/public/storage                # created by `php artisan storage:link`
/public/build                  # Vite build output (rebuilt with `npm run build`)
*.log
.phpunit.result.cache
.phpunit.cache
/.phpunit.cache
.phpactor.json

# Keep the folder structure (these hold a .gitignore of their own)
!/storage/logs/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore

# ---------------------------------------------------------------------
# Filament: published/compiled assets (regenerated by
# `php artisan filament:upgrade` / `filament:assets` on composer install)
# ---------------------------------------------------------------------
/public/css/filament
/public/js/filament
/public/fonts/filament
/public/css/app/*.css.map
/storage/app/livewire-tmp      # Livewire temporary file uploads
/storage/app/public/livewire-tmp

# ---------------------------------------------------------------------
# Livewire
# ---------------------------------------------------------------------
/public/vendor/livewire        # only exists if you published Livewire assets

# ---------------------------------------------------------------------
# Debug and monitoring tools (dev only)
# ---------------------------------------------------------------------
/public/vendor/telescope
/public/vendor/horizon
/public/vendor/pulse
/_ide_helper.php
/_ide_helper_models.php
/.phpstorm.meta.php
.php-cs-fixer.cache
.phpcs.cache
.phpstan.cache
/phpstan.neon.dist.cache

# ---------------------------------------------------------------------
# Tailwind / Node tooling
# ---------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn
.pnpm-store
.eslintcache
.stylelintcache
*.tsbuildinfo
# Commit ONE lock file only. If you use npm, uncomment the next two lines:
# yarn.lock
# pnpm-lock.yaml
# (never ignore composer.lock or package-lock.json: they pin exact versions)

# ---------------------------------------------------------------------
# Local database files and dumps
# ---------------------------------------------------------------------
/database/*.sqlite
/database/*.sqlite-journal
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.dump
*.bak
/database/backups

# ---------------------------------------------------------------------
# Uploads and user-generated content
# ---------------------------------------------------------------------
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/public/uploads

# ---------------------------------------------------------------------
# Local dev environments
# ---------------------------------------------------------------------
/.vagrant
Homestead.json
Homestead.yaml
/.ddev
/.lando.local.yml
docker-compose.override.yml
.herd
.valet
.docker
/.devcontainer/*.local
# Laravel Sail
/.sail

# ---------------------------------------------------------------------
# IDEs and editors
# ---------------------------------------------------------------------
/.idea
/.vscode
/.fleet
/.nova
/.zed
.vs/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
# If you want to share VS Code settings with the team, comment out
# the /.vscode line above and use these instead:
# /.vscode/*
# !/.vscode/settings.json
# !/.vscode/extensions.json

# ---------------------------------------------------------------------
# Operating system junk (you are on Windows, so these matter)
# ---------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
.AppleDouble
.LSOverride
._*
.Trash-*

# ---------------------------------------------------------------------
# Testing and coverage
# ---------------------------------------------------------------------
/coverage
/build
/.nyc_output
/tests/_output
/tests/Browser/screenshots/*
/tests/Browser/console/*
/tests/Browser/source/*
!/tests/Browser/screenshots/.gitignore
!/tests/Browser/console/.gitignore
!/tests/Browser/source/.gitignore

# ---------------------------------------------------------------------
# Deployment and misc
# ---------------------------------------------------------------------
/storage/app/backup*
*.zip
*.tar.gz
*.rar
*.7z
/.deployer
/deploy.php.local
.env.deploy
*.pem
*.key
*.crt
!/public/**/*.key              # allow public asset files that happen to end in .key (rare)